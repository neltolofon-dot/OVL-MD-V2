# ─────────────────────────────────────────────────────────────
#  OVL-MD-V2 — configuration
#  Copiez ce fichier en .env puis renseignez vos valeurs :
#     cp .env.example .env
#  Le fichier .env n'est jamais committé (voir .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Obligatoire ──────────────────────────────────────────────

# Identifiant de session WhatsApp.
#
# LAISSEZ VIDE si vous avez lancé `npm run pair` : les identifiants sont dans
# auth/principale/ et le bot les utilise directement, sans service externe.
#
# Sinon, générez une valeur sur https://ovl-web.koyeb.app/ (vos identifiants
# transitent alors par ce service tiers). Accepte aussi directement le JSON de
# vos creds Baileys, ou sa version base64.
SESSION_ID=

# Votre numéro WhatsApp, format international sans "+" ni espaces.
# Sans lui, aucune commande propriétaire ne fonctionnera.
NUMERO_OWNER=

# ── Recommandé ───────────────────────────────────────────────

# Préfixe des commandes. Ne le laissez jamais vide.
PREFIXE=.

# Nom affiché comme propriétaire du bot.
NOM_OWNER=Mon Nom

# public  = tout le monde peut utiliser le bot
# private = seuls le propriétaire et les sudo
MODE=public

NOM_BOT=🤖 OVL-MD BOT V2

# ── Base de données ──────────────────────────────────────────

# Vide  -> SQLite locale (./database.db), suffisant pour un VPS ou un panel.
# Sinon -> URL PostgreSQL (Supabase, Neon, Render...), nécessaire sur les
#          hébergeurs au disque éphémère (Heroku, Koyeb, Render free).
# Exemple : postgresql://utilisateur:motdepasse@hote:5432/base
DATABASE=

# ── Stickers ─────────────────────────────────────────────────

STICKER_PACK_NAME=OVL-MD-V2
STICKER_AUTHOR_NAME=OVL-MD

# ── Optionnel ────────────────────────────────────────────────

# Clé API Google Gemini pour les commandes d'IA (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Service de récupération des sessions. Changez-le pour pointer vers votre
# propre instance, ou ignorez-le si vous fournissez auth/principale/creds.json.
# SESSION_API=https://ovl-web.koyeb.app/getsession?id=

# "off" désactive l'auto-ping qui empêche la mise en veille sur les
# hébergeurs gratuits. Inutile en local.
# AUTO_PING=off

# "off" empêche le bot de lancer `npm install` tout seul au démarrage.
# AUTO_INSTALL=off

# Discussions exclues de l'auto-réaction, séparées par des virgules.
# NO_AUTOREACT_JIDS=

# Nombre de messages gardés en mémoire pour l'antidelete (défaut 2000).
# STORE_MAX_MESSAGES=2000

# Délai avant la connexion WhatsApp au démarrage, en ms (défaut 2000).
# DELAI_DEMARRAGE_MS=2000

# Port du serveur web de supervision (défaut 3000).
# PORT=3000

# Chemin du fichier SQLite. Utile pour le placer sur un volume persistant
# (Docker, VPS) au lieu du dossier de travail. Ignoré si DATABASE est renseigné.
# SQLITE_PATH=./database.db
